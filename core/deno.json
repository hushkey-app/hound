{
  "name": "@hushkey/hound",
  "version": "0.60.0",
  "description": "Deno-native job queue. Sorted-set delivery, crash recovery via Reaper, cron scheduling, and a management API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hushkey-app/hound"
  },
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test -A tests/"
  },
  "publish": {
    "exclude": [
      ".github/",
      ".vscode/",
      ".git/",
      "**/.DS_Store",
      "Makefile",
      "tests/"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "semiColons": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-unused-vars",
        "no-explicit-any",
        "require-await"
      ],
      "tags": [
        "recommended"
      ]
    }
  }
}
